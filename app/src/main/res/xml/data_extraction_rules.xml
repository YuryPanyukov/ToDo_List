<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила извлечения при переносе/клонировании + облачном бэкапе.
  Приватные данные (задачи, настройки) не покидают устройство.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml" />
        <exclude domain="database" path="todo.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml" />
        <exclude domain="database" path="todo.db" />
    </device-transfer>
</data-extraction-rules>