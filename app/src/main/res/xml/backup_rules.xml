<?xml version="1.0" encoding="utf-8"?>
<!--
  Авто-бэкап: по умолчанию Android 12+ не сохраняет всё.
  Явно запрещаем вынос пользовательских данных — задачи и prefs.
  Оставляем только то, что не содержит приватных данных (нечего).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="app_prefs.xml" />
    <exclude domain="database" path="todo.db" />
    <exclude domain="database" path="todo.db-shm" />
    <exclude domain="database" path="todo.db-wal" />
</full-backup-content>